<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Extensions</RootNamespace>
    <AssemblyName>CAE-Default</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <PreferNativeArm64>false</PreferNativeArm64>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <PreferNativeArm64>true</PreferNativeArm64>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Be.Windows.Forms.HexBox" Version="1.6.1" />
    <PackageReference Include="ExCSS" Version="4.2.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="AuthView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="CookieView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="DataView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="HeaderView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="HeaderView.Designer.cs">
      <DependentUpon>HeaderView.cs</DependentUpon>
    </Compile>
    <Compile Update="HexView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ImageView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ImageView.Designer.cs">
      <DependentUpon>ImageView.cs</DependentUpon>
    </Compile>
    <Compile Update="RawText.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RawText.Designer.cs">
      <DependentUpon>RawText.cs</DependentUpon>
    </Compile>
    <Compile Update="TransformerView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="WebViewRenderer.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="HeaderView.resx">
      <DependentUpon>HeaderView.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ImageView.resx">
      <DependentUpon>ImageView.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="RawText.resx">
      <DependentUpon>RawText.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clearinet\Clearinet.csproj" />
  </ItemGroup>
  <!-- Resolve TargetPath before expanding the post-build event. -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <PostBuildEvent>powershell -Command "$destDir = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'Clearinet\Extensions'; if (!(Test-Path $destDir)) { New-Item -ItemType Directory -Path $destDir -Force }; Copy-Item -Path '$(TargetPath)', '$(TargetDir)Be.Windows.Forms.HexBox.dll', '$(TargetDir)Microsoft.Web.WebView2.Core.dll', '$(TargetDir)Microsoft.Web.WebView2.WinForms.dll' -Destination $destDir -Force; Copy-Item -Path '$(TargetDir)runtimes' -Destination $destDir -Recurse -Force"</PostBuildEvent>
  </PropertyGroup>
</Project>